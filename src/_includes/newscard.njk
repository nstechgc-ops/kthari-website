<a class="ncard" href="{{ post.url | replace('.html','') }}">
  {% if post.data.image %}<img src="{{ post.data.image | u }}" alt="" loading="lazy">{% endif %}
  <div class="nbody">
    <div class="beast">{{ post.date | niceDate }}</div>
    <h3>{{ post.data.title }}</h3>
    {% if post.data.summary %}<p>{{ post.data.summary }}</p>{% endif %}
  </div>
</a>
