---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and (p.url == '/' or p.url.endsWith('.html')) %}
  <url><loc>{{ site.url }}{{ p.url | replace('index.html','') | replace('.html','') }}</loc></url>
{%- endif %}{% endfor %}
</urlset>
